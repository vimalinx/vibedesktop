{
  "name": "vibedesktop",
  "version": "0.1.1",
  "description": "A local-first, single-user web desktop that runs on your own machine with no login and no cloud account.",
  "license": "Apache-2.0",
  "author": "Vimalinx",
  "homepage": "https://vibedesktop.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimalinx/vibedesktop.git"
  },
  "bugs": {
    "url": "https://github.com/vimalinx/vibedesktop/issues"
  },
  "keywords": [
    "desktop",
    "local-first",
    "self-hosted",
    "webapps",
    "nextjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "//private": "This is an application, not an npm package. `private` stays true so `npm publish` cannot run by accident.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "desktop:open": "node scripts/launch-desktop-chromium.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-css-literals.mjs && node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "daemon": "node daemon/server.mjs",
    "dist:generate": "tsx scripts/generate-dist.ts",
    "release:verify": "node scripts/verify-release.mjs",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "catalog:stage": "node scripts/stage-catalog.mjs",
    "lint:css-literals": "node scripts/check-css-literals.mjs --report",
    "lint:contrast": "node scripts/check-contrast.mjs --report"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/postcss": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "^15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.34",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.24",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    }
  }
}
