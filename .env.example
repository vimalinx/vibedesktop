# Vibe Desktop — pure local, single user, no login.
# Do not put secrets in public browser variables.

NEXT_PUBLIC_APP_NAME="Vibe Desktop"

# Canonical external browser origin, used to reject cross-site writes. Leave it
# empty for a direct loopback run (localhost, 127.0.0.x, [::1]), dev or
# production: there the request URL is the browser origin, so it is inferred.
# Set it whenever something rewrites the host or port in between — a reverse proxy
# on a real hostname (HTTPS required), or an SSH port forward, where a loopback
# http:// value is accepted. Example: VIBE_PUBLIC_ORIGIN="http://localhost:8080"
VIBE_PUBLIC_ORIGIN=""

# Local JSON file persistence.
VIBE_DATA_FILE=".data/vibedesktop-dev.json"

# Local `vibed` process only.
VIBE_DAEMON_DATA_DIR=""

# Optional public app catalog: a static, read-only list of links the app store
# can offer alongside the built-in seed. Empty by default — a local-first
# desktop should not call out to a third party on first run without being asked.
# To opt in, point this at a published catalog artifact, for example:
#   VIBE_CATALOG_URL="https://github.com/vimalinx/vibedesktop/releases/latest/download/catalog.json"
VIBE_CATALOG_URL=""

# Last-good copy of the fetched catalog. Serving a stale cache is always
# preferred over showing nothing, so this file is used whenever a fetch fails.
VIBE_CATALOG_CACHE_FILE=".data/catalog-cache.json"

# How long a cached catalog is served without refetching. A cache older than
# this is still served if the network fails — staleness never breaks the store.
VIBE_CATALOG_MAX_AGE_HOURS="24"

# Your own collection: the same entry format, in a file you own and can edit by
# hand. It takes precedence over both the public catalog and the built-in seed.
VIBE_LOCAL_CATALOG_FILE=".data/local-catalog.json"
